{
  "name": "pixel-pomodoro-pet",
  "private": true,
  "version": "0.1.0",
  "description": "Pomodoro de escritorio siempre visible con una mascota pixel-art developer",
  "license": "MIT",
  "author": "LuisUmina",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuisUmina/pixel-pomodoro-pet.git"
  },
  "homepage": "https://github.com/LuisUmina/pixel-pomodoro-pet#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm test && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icon.mjs && tauri icon assets/icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.2",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^2.1.9"
  }
}
